#!/bin/sh
# Focus the agent in another workspace that needs me most: `blocked` first,
# then `done`, then `working`, newest first within each group.
# Focusing a `done` agent marks it seen, so it stops competing on its own.
set -eu

PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

target=$(jq -nr \
  --argjson agents "$(herdr agent list)" \
  --argjson panes "$(herdr pane list)" '
  ([$panes.result.panes[] | select(.focused == true) | .workspace_id] | first) as $current_ws
  | [$agents.result.agents[]
      | .rank = ({blocked: 0, done: 1, working: 2}[.agent_status])
      | select(.rank != null and .workspace_id != $current_ws)]
  | sort_by(.rank, -.state_change_seq)
  | first // empty
  | .name // .pane_id')

if [ -n "$target" ]; then
  herdr agent focus "$target" >/dev/null
fi
