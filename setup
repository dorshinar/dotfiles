#!/bin/zsh

set -euo pipefail

ROOT_DIRECTORY="${0:A:h}"

echo "🚀 Setup links from $ROOT_DIRECTORY"

ln -vnfs "$ROOT_DIRECTORY" "$HOME/.dotfiles"
ln -vnfs "$ROOT_DIRECTORY/.zshrc" "$HOME/.zshrc"
ln -vnfs "$ROOT_DIRECTORY/.zshenv" "$HOME/.zshenv"

if [[ "$OSTYPE" == darwin* ]]; then
  ln -vnfs "$ROOT_DIRECTORY/Brewfile" "$HOME/Brewfile"
  source "$ROOT_DIRECTORY/scripts/homebrew"
else
  source "$ROOT_DIRECTORY/scripts/linux-tools"
fi
source "$ROOT_DIRECTORY/scripts/installs"

mkdir -p ~/.config
ln -vnfs "$ROOT_DIRECTORY/starship/starship.toml" ~/.config

mkdir -p ~/.config/ghostty
ln -vnfs "$ROOT_DIRECTORY/ghostty/.config" ~/.config/ghostty/config

mkdir -p ~/.config/herdr
ln -vnfs "$ROOT_DIRECTORY/herdr/config.toml" ~/.config/herdr/config.toml
ln -vnfs "$ROOT_DIRECTORY/herdr/attention" ~/.config/herdr/attention

# The desktop app (macOS only) keeps its own keys and mods under ~/.config/herdr-app
if [[ "$OSTYPE" == darwin* ]]; then
  mkdir -p ~/.config/herdr-app/mods
  ln -vnfs "$ROOT_DIRECTORY/herdr-app/mods/attention" ~/.config/herdr-app/mods/attention
  [[ -e ~/.config/herdr-app/keys.json ]] || ln -vnfs "$ROOT_DIRECTORY/herdr-app/keys.json" ~/.config/herdr-app/keys.json
fi

mkdir -p ~/.claude/skills
for skill in "$ROOT_DIRECTORY"/claude/skills/*/; do
  ln -vnfs "${skill%/}" ~/.claude/skills/
done
