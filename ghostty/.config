window-padding-x = 16
window-padding-y = 16
confirm-close-surface = false
theme = Blue Matrix
macos-option-as-alt = true
split-divider-color = #686868
keybind = cmd+right=text:\x05
keybind = cmd+left=text:\x01
keybind = cmd+backspace=text:\x15
keybind = cmd+delete=text:\x0B
keybind = cmd+k=text:\x0c
keybind = alt+delete=esc:d
keybind = alt+left=esc:b
keybind = alt+right=esc:f
# opt+[ / opt+] natively send ESC [ / ESC ] (CSI/OSC introducers), which apps can't parse as keypresses
keybind = alt+left_bracket=esc:{
keybind = alt+right_bracket=esc:}
font-family = "JetBrainsMono Nerd Font Mono"
shell-integration-features = no-title
window-save-state = always

# Add cmd+a, cmd+x, select+write, select+paste
keybind = shift+enter=text:\x1b\r
